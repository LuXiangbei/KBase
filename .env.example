# KBase 配置示例。复制为 .env 后按需修改；.env 不入库。
KBASE_HOST=127.0.0.1
KBASE_PORT=8010
KBASE_DATA_DIR=data

# 检索参数
KBASE_EMBED_DIM=1024
KBASE_RETRIEVE_TOP_K=50
KBASE_RERANK_TOP_K=6
KBASE_RRF_K=60
KBASE_REFUSAL_THRESHOLD=0.03
KBASE_REFUSAL_WEAK=0.34
KBASE_REFUSAL_COVERAGE=0.18

# 分块参数
KBASE_CHUNK_MAX_TOKENS=420
KBASE_CHUNK_OVERLAP=0.15
KBASE_PARENT_MAX_TOKENS=1800

# 语义缓存与成本核算
KBASE_CACHE_ENABLED=true
KBASE_CACHE_THRESHOLD=0.95
KBASE_CACHE_TTL_SECONDS=1800
KBASE_PRICE_INPUT_PER_1K=0.001
KBASE_PRICE_OUTPUT_PER_1K=0.002

# 模型：local（离线确定性）或 deepseek（OpenAI 兼容接口）
KBASE_LLM_PROVIDER=local
KBASE_OPENAI_BASE_URL=https://api.deepseek.com
KBASE_OPENAI_API_KEY=
KBASE_OPENAI_MODEL=deepseek-flash
KBASE_OPENAI_MODEL_DEEP=deepseek-v4-pro
KBASE_MAX_TOKENS_SIMPLE=400
KBASE_MAX_TOKENS_COMPLEX=900
KBASE_LLM_TIMEOUT=60
